// parent wait for the child child sleep(3)
//parent check after 1s the child exit or not
// and at each time of checking it will show the
// msg so here we use for this waitpid(pid,null,WNOHANG)
#include<stdio.h>
#include<sys/wait.h>
#include<unistd.h>
#include<sys/types.h>
#include<stdlib.h>
int main()
{
pid_t pid=fork();
int num=5;

 printf("\n");
if(pid<0)
{
    perror("child not created\n");
    return 1;
}
else if(pid==0)
{
    printf("child process\n");
    exit(5);
   printf("\n");
}
else
{
  printf("parent process\n"); 
   printf("parent wait \n"); 
   int exitvalue;
   wait(&exitvalue);
   printf("Exit value of the child =%d",WEXITSTATUS(exitvalue));
    printf("\n");
 
} 
    return 0;
}
