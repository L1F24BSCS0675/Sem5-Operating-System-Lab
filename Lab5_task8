
#include<stdio.h>
#include<sys/wait.h>
#include<unistd.h>
#include<sys/types.h>
#include<stdlib.h>

int main()
{
    pid_t pid = fork();

    if(pid < 0)
    {
        perror("child not created");
        return 1;
    }
    else if(pid == 0)
    {
        printf("Child process\n");
        printf("Child PID = %d\n", getpid());

        sleep(1);

        printf("Child is still alive\n");
        printf("Child PID = %d\n", getpid());
        printf("New Parent PID = %d\n", getppid());

        exit(0);
    }
    else
    {
        printf("Parent process\n");
        printf("Parent PID = %d\n", getpid());
        printf("Parent is exiting without call the wait() fun \n");

        exit(0);
    }

    return 0;
}
