#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <string.h>
#include <sys/wait.h>
int main(int argc,char* argv[])
{

    int count=argc-1;
    int values[count];

    for (int i=0;i<count;i++)
    {
        values[i]=atoi(argv[i+1]);
    }
   int fd[2];
   int fd2[2];
   
   if(pipe(fd)==-1)
   {
       perror("No pipe ");
       return -1;
   }
   if(pipe(fd2)==-1)
   {
       perror("No pipe ");
       return -1;
   }
   
   int pid=fork();
   if(pid==-1)
   {
       perror("No child creat");
       return -1;
   }
   else if(pid==0)
   {
       int digits[100]={0};
       close(fd[1]);
       read(fd[0],digits,count*sizeof(int));// how many bites read from the pipe 
      
      for(int i=0;i<count-1;i++)
      {
          for(int j=0;j<count-i-1;j++)
          {
              if(digits[j] > digits[j+1])
                {
                 int temp=digits[j];
               digits[j]=digits[j+1];
                digits[j+1]=temp;
              }
          }
      }
        close(fd2[0]);
        write(fd2[1],digits,count*sizeof(int));
        close(fd2[1]);
        exit(0);
   }
   else
   {
    int data[100]={0};
    close(fd[0]);
    write(fd[1],values,count*sizeof(int));// how many bytes write from the values
    close(fd[1]);
    
    wait(0);
    
    close(fd2[1]);
        read(fd2[0],data,count*sizeof(int));
        for (int i=0;i<count;i++)
        {
            printf("%d",data[i]);
        }
     close(fd2[0]);
   }
   
    return 0;
}
