#include <fcntl.h>
#include <stdlib.h>
#include <sys/types.h>
#include <sys/wait.h>
#include <sys/file.h>
#include <stdio.h>
#include <unistd.h>

int main(int argc, char *argv[])
{
    int fd;
    fd = open(argv[1], O_CREAT | O_TRUNC | O_RDWR, 0777);
    dup2(fd, 1);
    close(fd);
    execlp(argv[2], argv[2], "/", argv[3], NULL);

    return 0;
}
