
#include<stdio.h>
#include<sys/wait.h>
#include<unistd.h>
#include<sys/types.h>
#include<stdlib.h>

int main()
{
    pid_t pid = fork();

    printf("\n");

    if(pid < 0)
    {
        perror("child not created");
        return 1;
    }
    else if(pid == 0)
    {
        printf("child process\n");
        printf("child id = %d\n", getpid());
        printf("child terminated\n");
        exit(0);
    }
    else
    {
        printf("parent process\n");
        printf("parent sleep\n");

        sleep(5);

        printf("parent process collects the child status\n");

   
    }

    return 0;
}
