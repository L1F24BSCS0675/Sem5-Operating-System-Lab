{
pid_t pid=fork();
if(pid<0)
{
    perror("child not created\n");
    return 1;
}
else if(pid==0)
{
    printf("child process\n");
    printf("child id=%d",getpid());
     printf("\n");
     printf("child parent id=%d",getppid());
      printf("\n");
}
else
{
  printf("parent process\n");  
   printf("parent id=%d",getpid());
    printf("\n");
    printf("parent parent id=%d",getppid());
     printf("\n");
}  
    
    
    
    
    return 0;
}
