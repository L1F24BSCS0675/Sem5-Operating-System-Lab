#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <string.h>
#include <sys/wait.h>
int main()
{
   int fd[2];
   int msg[]={1,2,3,4};
   if(pipe(fd)==-1)
   {
       perror("No pipe ");
       return -1;
   }
   int pid=fork();
   if(pid==-1)
   {
       perror("No child creat");
       return -1;
   }
   else if(pid==0)
   {
       int digits[100]={0};
       close(fd[1]);
      int n= read(fd[0],digits,100);
      
       int sum=0;
       for (int i=0;i<n;i++)
       {
           sum=sum+digits[i];
       }
       printf("Sum in the child data come from parent= %d",sum);
        close(fd[0]);
        exit(0);
   }
   else
   {
    close(fd[0]);
    write(fd[1],msg,sizeof(msg));
   close(fd[1]);
   wait(0);
   }
   
    return 0;
}
