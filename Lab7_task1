#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>

int main(int argc, char *argv[])
{
    int fd[2];

   pipe(fd);

    int pid = fork();

    if (pid > 0)
    {
        //parent, writer 
        close(fd[0]);
        dup2(fd[1], 1);
        close(fd[1]);
        execlp(argv[1], argv[1], NULL);
        perror("exec writer failed");
    }
    else if (pid == 0)
    {
        //child, reader 
        close(fd[1]);
        dup2(fd[0], 0);
        close(fd[0]);
        execlp(argv[2], argv[2], NULL);
        perror("exec reader failed");
    }
    else
    {
        perror("fork failed");
        exit(2);
    }

    return 0;
}
