
#include<stdio.h>
#include<sys/wait.h>
#include<unistd.h>
#include<stdlib.h>
#include<sys/types.h>

int main()
{
    pid_t pid = fork();

    printf("\n");

    if(pid < 0)
    {
        perror("child not created");
        return 1;
    }
    else if(pid == 0)
    {
        printf("child process\n");
        sleep(2);
        printf("child task completed\n");
        exit(2);
    }
    else
    {
        printf("parent process\n");
        printf("parent wait\n\n");

        int status;
        int a = waitpid(pid, &status, WNOHANG);

        while(1)
        {
            if(a == pid)
            {
                break;
            }
            else if(a == 0)
            {
                printf("Parent waiting for the child exit\n");
                sleep(1);
                a = waitpid(pid, &status, WNOHANG);
            }
            else
            {
                perror("Error");
                return 1;
            }
        }

        if(WIFEXITED(status))
        {
            printf("Child exit status = %d\n", WEXITSTATUS(status));
        }
    }

    return 0;
}
